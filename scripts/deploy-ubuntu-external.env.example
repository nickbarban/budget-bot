# Copy to scripts/deploy-ubuntu-external.env and fill in.
# That file is gitignored.

DEPLOY_SSH=user@your-ubuntu-host
DEPLOY_REMOTE_DIR=/opt/budget-bot

# Optional. Defaults shown.
# DEPLOY_REGISTRY_HOST=host.docker.internal:5001
# DEPLOY_COMPOSE_SERVICE=backend
# DEPLOY_REMOTE_WORKFLOW_DIR=/opt/budget-bot/n8n
# Host ports on Ubuntu when 8080/5432 are already taken:
# DEPLOY_BACKEND_HOST_PORT=18080
# DEPLOY_POSTGRES_HOST_PORT=15432

# Optional overrides written into docker-compose.deploy.yml on the remote.
# If empty, values come from the copied backend .env.
# DEPLOY_TELEGRAM_BOT_TOKEN=
# DEPLOY_TELEGRAM_WEBHOOK_SECRET=
# DEPLOY_MONOBANK_TOKEN=
# DEPLOY_MONOBANK_ACCOUNT_ID=0
