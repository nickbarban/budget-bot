# n8n
N8N_BASE_URL=https://n8n.example.com

# Spring Boot backend
BUDGET_BACKEND_URL=https://budget-api.example.com
BUDGET_BACKEND_API_KEY=change-me

# Telegram is configured as an n8n credential, not stored here.
# Credential name expected by the workflows: Budget Bot Telegram

# Optional shared secret used by n8n when forwarding bank webhooks.
BANK_WEBHOOK_FORWARD_SECRET=change-me
